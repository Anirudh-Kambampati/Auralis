{
  "name": "auralis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch server/index.js\" \"vite --host\"",
    "dev:all": "npm run dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.js",
    "test": "node --test shared/game.test.js shared/stats.test.js server/store.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-presigned-post": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "files-sdk": "^3.1.2",
    "pg": "^8.23.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
