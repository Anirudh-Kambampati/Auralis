# Copy to .env (never commit .env or .env.local).
# `neon deploy` writes the Neon values into .env.local for you.

# A throwaway database for the storage conformance suite (npm test). Normally a Neon branch.
# Never set this to DATABASE_URL: the suite writes and deletes rows.
# TEST_DATABASE_URL=
# --- Game server (local, or the Render dashboard) ---
# Neon Postgres. Without it the server uses a local SQLite file.
DATABASE_URL=
# Neon Object Storage (room snapshots, chat pictures and files). Without these, they are off.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Every website address that may call this server or open its socket (comma-separated), e.g.
# https://auralis.vercel.app,https://auralis.netlify.app
# A password-reset link opens whichever of these the request came from, so each front end keeps its own domain.
ALLOWED_ORIGINS=
PORT=8787
# Boot with a stub per player and read the full row on demand, instead of parsing every account at start.
# LAZY_PLAYERS=1
# Password reset mail. Render's free plan blocks outbound SMTP, so this goes over an HTTP API.
# brevo needs no domain: verify your own address in the Brevo dashboard (Senders) and put it here.
# resend needs a domain you control, verified with DNS records.
# Without MAIL_API_KEY a reset link is only logged and no mail is sent (nothing else breaks).
# MAIL_DRY_RUN=1 prints the mail instead of sending it, which is how the e2e check runs.
# MAIL_PROVIDER=brevo
# MAIL_FROM=you@example.com
# MAIL_FROM_NAME=Auralis
# MAIL_API_KEY=

# The website's public address, used to build reset links (no trailing slash).
# Unset falls back to the first ALLOWED_ORIGINS entry, then http://localhost:$PORT.
# SITE_URL=https://auralis.example.com

# Web Push, so to-do reminders reach people with Auralis closed. Make a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Website build (the Vercel dashboard) ---
# Where the game server lives. Leave unset when the server also serves the website.
# VITE_API=https://auralis-server.onrender.com
# VITE_SERVER=wss://auralis-server.onrender.com/ws

# --- Connectors (all optional; the three keyless ones work without any of this) ---
# GitHub's public API allows 60 requests an hour per address, shared by every player on this server.
# A token (no scopes needed for public events) makes it 5,000 an hour for everyone.
# GITHUB_TOKEN=
# Spotify, for the record player's now playing. Create an app at developer.spotify.com, add
# <server address>/api/connectors/spotify/callback as a Redirect URI: http://127.0.0.1:8787/api/connectors/spotify/callback
# locally (127.0.0.1, never localhost — Spotify refuses localhost), and an https one in production.
# Copy the app's Client ID and secret here; Dev Mode needs the owner on Premium and admits five allowlisted listeners.
# Development Mode needs the app owner to have Premium and is capped at five allowlisted listeners.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Set only when the website and the server are on different hosts, to that exact https callback.
# SPOTIFY_REDIRECT_URI=
# Play/pause/skip on the record player needs user-modify-playback-state. An account linked before that scope
# existed must be reconnected (Settings > Connectors > Spotify); playback also needs Premium and an active device.
