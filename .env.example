# Copy to .env (never commit .env or .env.local).
# `neon deploy` writes the Neon values into .env.local for you.

# --- Game server (local, or the Render dashboard) ---
# Neon Postgres. Without it the server uses a local SQLite file.
DATABASE_URL=
# Neon Object Storage (room snapshots, chat pictures and files). Without these, they are off.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# The website's address when it is hosted elsewhere (comma-separated), e.g. https://auralis.vercel.app
ALLOWED_ORIGINS=
PORT=8787
# Password reset emails, through Brevo (free: 300 a day; brevo.com → SMTP & API → API keys).
# MAIL_FROM must be a sender address you verified in Brevo. Without these, reset emails are printed in the server log
# locally, and "Forgot password?" says it isn't set up on Render.
BREVO_API_KEY=
MAIL_FROM=
# The website's address for links in emails. Defaults to the first ALLOWED_ORIGINS entry.
SITE_URL=
# Web Push, so to-do reminders reach people with Auralis closed. Make a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Website build (the Vercel dashboard) ---
# Where the game server lives. Leave unset when the server also serves the website.
# VITE_API=https://auralis-server.onrender.com
# VITE_SERVER=wss://auralis-server.onrender.com/ws
